# Copia in .env e riavvia il server per applicare.
PORT=3000
# Cartella dei dati (clienti, token, progetti grafici, file caricati). Predefinita: data
DATA_DIR=data

# Indirizzo https da cui Habitat è raggiungibile da internet (tunnel), per i link da mandare ai clienti.
# Vuoto: i link si aprono solo da questo computer. Guida in COLLEGAMENTI.md, "Link per il cliente".
PUBLIC_URL=

# Accesso con password da internet (VPS o tunnel). Vuoto: da fuori si vede solo il link del cliente.
# Genera la riga con `npm run password` e incollala qui. Da localhost la password non serve mai.
HABITAT_PASSWORD_HASH=
# Chiave che firma le sessioni: una stringa lunga e casuale. Senza, i login decadono a ogni riavvio.
SESSION_SECRET=
# Giorni di durata del login (predefinito 14).
HABITAT_SESSION_DAYS=

# Login Meta (Facebook + Instagram). Guida in COLLEGAMENTI.md
META_APP_ID=
# Facoltativo: ID della configurazione di Facebook Login for Business (al posto dell'elenco dei permessi).
META_CONFIG_ID=
META_APP_SECRET=
# Versione Graph API: Meta ritira ogni versione dopo circa due anni.
META_GRAPH_VERSION=v25.0
# Facoltativo: predefinito http://localhost:PORT/oauth/meta/callback
META_REDIRECT_URI=

# Login TikTok (Login Kit). Guida in COLLEGAMENTI.md
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Facoltativo: predefinito http://localhost:PORT/oauth/tiktok/callback
TIKTOK_REDIRECT_URI=
