# Copia in .env e riavvia il server per applicare.
PORT=3000
# Cartella dei dati (clienti, token, progetti grafici, file caricati). Predefinita: data
DATA_DIR=data

# Login Meta (Facebook + Instagram). Guida in COLLEGAMENTI.md
META_APP_ID=
META_APP_SECRET=
# Versione Graph API: Meta ritira ogni versione dopo circa due anni.
META_GRAPH_VERSION=v25.0
# Facoltativo: predefinito http://localhost:PORT/oauth/meta/callback
META_REDIRECT_URI=

# Login TikTok (Login Kit). Guida in COLLEGAMENTI.md
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Facoltativo: predefinito http://localhost:PORT/oauth/tiktok/callback
TIKTOK_REDIRECT_URI=
